        lines {
          text: "    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuDhQzUJfWvtzhBT6HAR3ZNjjKvD-RAZWgPHvMfI5N8DuQZe3v7n8RP9VkWNZ-V1Uw5rD2h-P1-5KnkO_ZCRNwZ1vfhXOpEkJf8jKm7wV91rKRNE3_4iPfcx7ymlcZXPEAm01vBIB_8n-PRlI-274FPZbfwPbRpLWn_z8niyPOOqxJ_iZsOzIEFMgQXGGHR2dcFpCnyY4pgzzfEP2nojB3BrydcYlfeMC3cqKaYRG2-KQdxpMREqmObL\',"
