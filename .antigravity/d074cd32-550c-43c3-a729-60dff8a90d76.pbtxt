        lines {
          text: "    roleId: \'Arsitek Utama & Pendiri\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuAyutdWxO0xpYkftSWpyVITRA6cb1F-biCWlRrSujbeIgSdW8rILIj0bQsPpkgFGI_HVIes0RVn7OACbeKBNofQl790iqS2ttZI8JW-W5dQ7iC5YPI5YjMaIk0JKR3iVb-9Jc5D4jHwNqT55RNk2Uz2yIYL5mhbGKo808ivM6BKmHUT9FMH5TiW4VvpVMV_XQKc6osKYJjYGUahX-G8ieh-_3PBlb1C8UkHzHJp4d-ljnBcHC9F4yZ5\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    bio: \'Adrian memiliki lebih dari 15 tahun pengalaman mendesain struktur ikonik di Asia Tenggara. Berfokus pada perpaduan antara brutalitas fungsional dan keindahan material mentah, ia percaya arsitektur adalah dialog abadi antara manusia dan alam.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
