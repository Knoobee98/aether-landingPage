  file_change {
    absolute_path_uri: "file:///src/components/Header.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Menu, X, Sun, Moon, ArrowUpRight } from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\n\ninterface HeaderProps {\n  currentView: string;\n  setView: (view: string) => void;\n  darkMode: boolean;\n  toggleDarkMode: () => void;\n  openContact: () => void;\n}\n\nexport default function Header({ currentView, setView, darkMode, toggleDarkMode, openContact }: HeaderProps) {\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const navItems = [\n    { id: \'home\', label: \'Beranda\' },\n    { id: \'services\', label: \'Layanan\' },\n    { id: \'portfolio\', label: \'Portofolio\' },\n    { id: \'about\', label: \'Tentang\' },\n    { id: \'blog\', label: \'Jurnal\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 w-full border-b backdrop-blur-md transition-colors duration-300 border-border-light bg-bg-light/80 dark:border-border-dark dark:bg-bg-dark/80\">\n      <div className=\"mx-auto flex h-20 max-w-7xl items-center justify-between px-6 sm:px-8\">\n        \n        {/* Logo */}\n        <div \n          onClick={() => { setView(\'home\'); setMobileMenuOpen(false); }}\n          className=\"group flex cursor-pointer flex-col items-start\"\n          id=\"header-logo-container\"\n        >\n          <span className=\"font-display text-xl font-bold tracking-[0.25em] text-primary-light transition-colors duration-300 dark:text-primary-dark sm:text-2xl\">\n            AETHER\n          </span>\n          <span className=\"font-mono text-[9px] tracking-[0.4em] text-muted-light dark:text-muted-dark uppercase mt-0.5\">\n            Architecture\n          </span>\n        </div>\n\n        {/* Desktop Navigation */}\n        <nav className=\"hidden md:flex items-center space-x-8\" id=\"desktop-nav\">\n          {navItems.map((item) => {\n            const isActive = currentView === item.id;\n            return (\n              <button\n                key={item.id}\n                id={`nav-item-${item.id}`}\n                onClick={() => setView(item.id)}\n                className={`relative py-2 text-xs font-medium uppercase tracking-widest transition-colors duration-200 cursor-pointer ${\n                  isActive \n                    ? \'text-primary-light dark:text-primary-dark\' \n                    : \'text-muted-light hover:text-primary-light dark:text-muted-dark dark:hover:text-primary-dark\'\n                }`}\n              >\n                {item.label}\n                {isActive && (\n                  <motion.div \n                    layoutId=\"activeIndicator\"\n                    className=\"absolute bottom-0 left-0 h-[2px] w-full bg-primary-light dark:bg-primary-dark\"\n                    transition={{ type: \'spring\', stiffness: 300, damping: 30 }}\n                  />\n                )}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Header CTA & Toggle controls */}\n        <div className=\"hidden md:flex items-center space-x-6\" id=\"desktop-controls\">\n          {/* Theme Toggle */}\n          <button\n            onClick={toggleDarkMode}\n            id=\"theme-toggle-desktop\"\n            className=\"rounded-full p-2.5 transition-colors cursor-pointer text-muted-light hover:bg-black/5 hover:text-primary-light dark:text-muted-dark dark:hover:bg-white/5 dark:hover:text-primary-dark\"\n            aria-label=\"Toggle theme\"\n          >\n            {darkMode ? <Sun size={16} /> : <Moon size={16} />}\n          </button>\n\n          {/* CTA */}\n          <button\n            onClick={openContact}\n            id=\"cta-contact-desktop\"\n            className=\"group flex items-center space-x-2 border px-5 py-2.5 text-xs font-medium uppercase tracking-widest transition-all duration-300 cursor-pointer border-primary-light bg-primary-light text-bg-light hover:bg-transparent hover:text-primary-light dark:border-primary-dark dark:bg-primary-dark dark:text-bg-dark dark:hover:bg-transparent dark:hover:text-primary-dark\"\n          >\n            <span>Mulai Proyek</span>\n            <ArrowUpRight size={14} className=\"transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5\" />\n          </button>\n        </div>\n\n        {/* Mobile controls */}\n        <div className=\"flex items-center space-x-4 md:hidden\" id=\"mobile-controls\">\n          {/* Theme Toggle mobile */}\n          <button\n            onClick={toggleDarkMode}\n            id=\"theme-toggle-mobile\"\n            className=\"rounded-full p-2 text-muted-light dark:text-muted-dark\"\n            aria-label=\"Toggle theme\"\n          >\n            {darkMode ? <Sun size={18} /> : <Moon size={18} />}\n          </button>\n\n          {/* Mobile menu Button */}\n          <button\n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            id=\"mobile-menu-trigger\"\n            className=\"rounded-md p-2 text-primary-light dark:text-primary-dark focus:outline-none\"\n            aria-label=\"Toggle menu\"\n          >\n            {mobileMenuOpen ? <X size={24} /> : <Menu size={24} />}\n          </button>\n        </div>\n\n      </div>\n\n      {/* Mobile Menu Panel */}\n      <AnimatePresence>\n        {mobileMenuOpen && (\n          <motion.div\n            initial={{ opacity: 0, height: 0 }}\n            animate={{ opacity: 1, height: \'auto\' }}\n            exit={{ opacity: 0, height: 0 }}\n            transition={{ duration: 0.3, ease: \'easeInOut\' }}\n            id=\"mobile-nav-panel\"\n            className=\"border-b md:hidden border-border-light bg-bg-light dark:border-border-dark dark:bg-bg-dark\"\n          >\n            <div className=\"flex flex-col space-y-4 px-6 py-6 pb-8\">\n              {navItems.map((item) => {\n                const isActive = currentView === item.id;\n                return (\n                  <button\n                    key={item.id}\n                    id={`mobile-nav-item-${item.id}`}\n                    onClick={() => {\n                      setView(item.id);\n                      setMobileMenuOpen(false);\n                    }}\n                    className={`text-left text-sm font-semibold uppercase tracking-wider py-2 transition-colors duration-200 cursor-pointer ${\n                      isActive \n                        ? \'text-primary-light dark:text-primary-dark\' \n                        : \'text-muted-light dark:text-muted-dark\'\n                    }`}\n                  >\n                    {item.label}\n                  </button>\n                );\n              })}\n              \n              <div className=\"pt-4 border-t border-border-light dark:border-border-dark\">\n                <button\n                  onClick={() => {\n                    openContact();\n                    setMobileMenuOpen(false);\n                  }}\n                  id=\"mobile-cta-contact\"\n                  className=\"flex w-full items-center justify-between border px-5 py-3 text-xs font-semibold uppercase tracking-widest transition-all border-primary-light bg-primary-light text-bg-light dark:border-primary-dark dark:bg-primary-dark dark:text-bg-dark\"\n                >\n                  <span>Mulai Konsultasi</span>\n                  <ArrowUpRight size={16} />\n                </button>\n              </div>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </header>\n  );\n}\n"
    }
