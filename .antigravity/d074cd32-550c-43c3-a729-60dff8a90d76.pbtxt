          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { label: \'Penurunan Banjir\', value: \'Reduksi 90%\' },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      { label: \'Kios UMKM Terfasilitasi\', value: \'45 Kios\' }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ]"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const BLOG_POSTS: BlogPost[] = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'masa-depan-arsitektur-berkelanjutan\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    title: \'Masa Depan Arsitektur Berkelanjutan\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    excerpt: \'Bagaimana material sirkular, beton ramah lingkungan, dan teknologi pendinginan pasif mengubah lanskap perkotaan masa kini.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    date: \'15 Mei 2026\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    readTime: \'6 menit baca\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Teknologi\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \'Adrian Wijaya\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuBgI5oWtAyTXkAhnh_gMgbjwpIO4U2_dz-3SHK97RiFfpN55UUFnNdxvuAiOaMgI8yG80knhnB2A9e9GSFz_MD1hTOsknisaW1kRAjtu-dnZXW1GETLMLNf0XDZEoxLiQyYqYA_d3nd8xmBKCqasNCK8wjwCiM_2YApmIEiPSfjAG3WCjVELqSZTKTDlA2NvaxTk25kuv3Gx643WLNYhNj_hp9KlC1PELpv3sWzfGmvm8ZZ_gHLYArT\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `Dunia arsitektur sedang mengalami revolusi diam-diam. Perubahan iklim bukan lagi ancaman teoritis melainkan realitas harian yang harus dijawab secara struktural oleh para arsitek. Desain berkelanjutan modern tidak lagi sekadar menaruh tanaman di balkon atau memasang panel surya di atap. Ia adalah tentang transformasi total materialitas dan metabolisme bangunan."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Di AETHER, kami mengeksplorasi penggunaan bahan sirkular, termasuk beton geopolimer abu terbang (fly-ash) yang memiliki jejak karbon 70% lebih rendah dibanding semen Portland biasa. Penggunaan kayu laminasi silang (cross-laminated timber/CLT) juga menjadi alternatif pengganti struktur baja struktural untuk beban menengah, menyimpan karbon secara permanen di dalam struktur bangunan."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Selain material, kunci keberlanjutan terletak pada sirkulasi mikrotermal pasif. Melalui pemodelan komputer termodinamika udara, kita dapat mendesain bentuk luar bangunan yang mengarahkan angin sejuk pegunungan atau laut untuk melintasi rongga-rongga koridor, meminimalkan kebutuhan pengkondisian udara (AC) buatan secara drastis.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'minimalisme-dalam-desain-modern\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    title: \'Minimalisme dalam Desain Modern\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    excerpt: \'Mengeksplorasi estetika fungsional murni. Menolak dekorasi berlebih demi menonjolkan esensi material mentah dan interaksi cahaya alami.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    date: \'28 April 2026\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    readTime: \'4 menit baca\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Filosofi\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \'Maya Santoso\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuC8hrLAHARTx3Nk4AiKlxRZarI0qnOegNcOv1VIolM8TjGSyA8O16dIIa6YyTFx2Aj_Xh9LqARz5ioPO6Y4rjhBcDvkpcoEX9LoHnEDiwmRt2A8S2bg1keoQmnLCfIPAFEY6tGJjEjXeras1oHNZix7hxIM_8Q4oT0s5Ro_UT5y7eXNR2k7h8sl63izBg26kloRzXRSe84tcS93P7uTDTc-oe2GiVb3l0f5wM0PmwiYz18FK63RMc-i\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `Seringkali orang salah mengartikan minimalisme sebagai ruang kosong yang steril, dingin, dan tidak ramah dihuni. Minimalisme yang sejati adalah penghapusan elemen sekunder guna menonjolkan esensi dari sebuah ruang: bentuk, proporsi, tekstur material, dan cahaya."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Ketika dinding dibebaskan dari ornamentasi yang mengalihkan perhatian, mata kita dipaksa mengapresiasi kejujuran material. Tekstur kasar dari beton cast-in-place, pola urat alami pada kayu jati daur ulang, atau kelembutan batu kapur lokal menjadi ornamen itu sendiri."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Bagi saya, arsitektur interior adalah kanvas bagi cahaya matahari. Pola bayangan yang terbentuk dari kisi-kisi atau bukaan geometris tipis berganti seiring pergeseran matahari, bertindak sebagai elemen dekoratif alami yang dinamis tanpa pernah mengacaukan visual ketenangan jiwa.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id: \'integrasi-teknologi-ruang-publik\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    title: \'Integrasi Teknologi dalam Ruang Publik\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    excerpt: \'Bagaimana sensor lingkungan pintar, manajemen air cerdas, dan desain inklusif dapat melahirkan ruang kota yang bernyawa.\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    date: \'12 April 2026\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    readTime: \'5 menit baca\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    category: \'Urban\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    author: \'Budi Pratama\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    image: \'https://lh3.googleusercontent.com/aida-public/AB6AXuDdVYPPkxIiaMAWyhejSpH-Nl008UIebdl7IYvPvGdZ8c0aOUYQDaaYaO30omlh1HQ29KuZRC9Gcf6Nsyj9eiv8GS-romNqP89a_a1XpHdIhkuYmq00jxcyaxDMcNTRdQXPWh-7duGxHIbO-H0oMcDhnQYFSslZNV0DUw5-6Ktb4rvcaTK95GBc9NF8vyOqlZrp59XSbkv-YgJBeE71RHIJN9fyCaO6v58rKfjZNufGFNffYc-NXCvO\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    content: `Ruang publik masa kini harus mampu merespon kebutuhan manusia dan tantangan lingkungan secara real-time. Melalui integrasi sensor IoT (Internet of Things) yang dipasang menyatu dalam furnitur perkotaan (street furniture) dan infrastruktur drainase, kita dapat menciptakan \'sistem saraf kota\' yang responsif."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Dalam proyek amfiteater dan bioswale modern, sensor pendeteksi kelembaban tanah dapat otomatis memicu katup drainase sekunder saat curah hujan tinggi, mencegah banjir lokal. Lampu jalan LED berdaya pancar adaptif meredup saat tidak ada pejalan kaki, menghemat konsumsi energi kota hingga 40%."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "Namun, teknologi bukan sekadar soal efisiensi. Integrasi layar informasi taktil interaktif dan transmisi audio nirkabel membantu kaum disabilitas sensorik bernavigasi dengan mandiri di ruang publik, mewujudkan demokrasi spasial yang inklusif.`"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const TESTIMONIAL = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  quote: \"Bekerja bersama AETHER memberikan kami perspektif baru tentang fungsionalitas murni. Struktur beton monolitik dan kulit ganda vegetasi di kantor pusat kami tidak hanya ikonik secara estetika, melainkan juga menekan biaya operasional gedung hingga 35%. Ini adalah presisi tanpa kompromi.\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  author: \"Budi Santoso\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  role: \"CEO Lumina Group\","
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  image: \"https://lh3.googleusercontent.com/aida-public/AB6AXuDJ07xFsawZfVyw3vVaiy6BCzq0a8jJv801H3yj2ZtOQHfSS4qqpHY_6dWRd7e12JFcAugEVh5x6PtG6Gwe16o3RdVMBJc32GDvz8gBmqy3xSWLHYcu0uWeBcfNrDPZxfiIH-tfJFA16URlCR5Wx6VPoa6aKKaUzPwJNxwiTlCRN8YHDS8XftvJeK0XK8VSLgcuT14gQv3nugBeVfAUdOAoVMJHUmzw0fZNxEtROyGA8sd_JU-Cd4hT\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
      }
    }
    overwrite: true
  }
}
