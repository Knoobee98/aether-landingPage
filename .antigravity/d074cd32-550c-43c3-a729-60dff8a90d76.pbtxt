    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Inbox, \n  Layers, \n  BarChart3, \n  TrendingUp, \n  Clock, \n  CheckCircle, \n  XCircle, \n  AlertCircle, \n  User, \n  Clipboard, \n  Mail, \n  ArrowRight, \n  Calendar, \n  Check, \n  Search, \n  Filter, \n  RefreshCw,\n  Copy,\n  FolderDot,\n  FileSpreadsheet\n} from \'lucide-react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Inquiry } from \'../types\';\n\ninterface AdminViewProps {\n  inquiries: Inquiry[];\n  onUpdateInquiry: (updated: Inquiry) => void;\n  onResetInquiries: () => void;\n}\n\nconst ARCHITECTS = [\n  { name: \'Adrian Sanjaya\', specialty: \'Arsitektur Komersial & Kinetik\' },\n  { name: \'Maya Lestari\', specialty: \'Residensial Bioklimatik\' },\n  { name: \'Budi Pratama\', specialty: \'Perencanaan Urban & Ekologi\' },\n  { name: \'Dina Wijaya\', specialty: \'Struktur & Desain Berkelanjutan\' }\n];\n\nexport default function AdminView({ inquiries, onUpdateInquiry, onResetInquiries }: AdminViewProps) {\n  const [activeTab, setActiveTab] = useState<\'inbox\' | \'kanban\' | \'analytics\'>(\'inbox\');\n  const [selectedInquiryId, setSelectedInquiryId] = useState<string | null>(\n    inquiries.length > 0 ? inquiries[0].id : null\n  );\n  \n  // Search & Filter state\n  const [searchTerm, setSearchTerm] = useState(\'\');\n  const [statusFilter, setStatusFilter] = useState<string>(\'all\');\n  const [typeFilter, setTypeFilter] = useState<string>(\'all\');\n  \n  // Copy notification status feedback\n  const [copiedDraft, setCopiedDraft] = useState(false);\n\n  // Set default selected inquiry if current selection is invalid or null\n  useEffect(() => {\n    if (inquiries.length > 0) {\n      if (!selectedInquiryId || !inquiries.some(i => i.id === selectedInquiryId)) {\n        setSelectedInquiryId(inquiries[0].id);\n      }\n    } else {\n      setSelectedInquiryId(null);\n    }\n  }, [inquiries, selectedInquiryId]);\n\n  const selectedInquiry = inquiries.find(i => i.id === selectedInquiryId);\n\n  // Filter inquiries\n  const filteredInquiries = inquiries.filter(inq => {\n    const matchesSearch = \n      inq.name.toLowerCase().includes(searchTerm.toLowerCase()) || \n      inq.id.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      inq.details.toLowerCase().includes(searchTerm.toLowerCase());\n    \n    const matchesStatus = statusFilter === \'all\' || inq.status === statusFilter;\n    const matchesType = typeFilter === \'all\' || inq.projectType === typeFilter;\n    \n    return matchesSearch && matchesStatus && matchesType;\n  });\n\n  // Calculate metrics\n  const totalCount = inquiries.length;\n  const pendingCount = inquiries.filter(i => !i.status || i.status === \'pending\').length;\n  const reviewingCount = inquiries.filter(i => i.status === \'reviewing\').length;\n  const approvedCount = inquiries.filter(i => i.status === \'approved\').length;\n  const declinedCount = inquiries.filter(i => i.status === \'declined\').length;\n\n  // Compute estimate pipeline value based on budget ranges\n  const computeBudgetNumeric = (budgetStr: string) => {\n    if (budgetStr.includes(\'<\')) return 300000000; // 300jt\n    if (budgetStr.includes(\'500 Juta\')) return 1250000000; // 1.25M\n    if (budgetStr.includes(\'2 Miliar\')) return 6000000000; // 6M\n    if (budgetStr.includes(\'>\')) return 15000000000; // 15M\n    return 1000000000;\n  };\n\n  const totalPipeline = inquiries\n    .filter(i => i.status !== \'declined\')\n    .reduce((sum, i) => sum + computeBudgetNumeric(i.budget), 0);\n\n  // Formatter for Currency\n  const formatIDR = (num: number) => {\n    if (num >= 1000000000) {\n      return `Rp ${(num / 1000000000).toFixed(1)} Miliar`;\n    }\n    return `Rp ${(num / 1000000).toFixed(0)} Juta`;\n  };\n\n  const handleStatusChange = (status: \'pending\' | \'reviewing\' | \'approved\' | \'declined\') => {\n    if (selectedInquiry) {\n      const updated = { ...selectedInquiry, status };\n      // Provide some default values if moving to in-review or approved\n      if (status === \'reviewing\' && !selectedInquiry.assignedTo) {\n        updated.assignedTo = ARCHITECTS[0].name;\n        updated.priority = \'medium\';\n      }\n      onUpdateInquiry(updated);\n    }\n  };\n\n  const handleFieldChange = (key: keyof Inquiry, value: any) => {\n    if (selectedInquiry) {\n      onUpdateInquiry({\n        ...selectedInquiry,\n        [key]: value\n      });\n    }\n  };\n\n  // Generate Email Draft based on current status\n  const generateClientLetter = (inq: Inquiry) => {\n    const pType = inq.projectType;\n    const clientName = inq.name;\n    const ticketId = inq.id;\n    const architect = inq.assignedTo || \'Tim Prinsipal AETHER\';\n    const timeline = inq.timelineEstimate || \'3 - 6 bulan\';\n\n    let content = \'\';\n\n    if (!inq.status || inq.status === \'pending\') {\n      content = `Yth. ${clientName},\\n\\nTerima kasih telah mengajukan rencana proyek Anda ke AETHER ARCHITECTURE.\\n\\nKami telah menerima pengajuan konsep proyek ${pType} Anda dengan nomor Tiket Registrasi: ${ticketId}. Saat ini tim kurasi teknis kami sedang mempelajari parameter awal tapak serta kelayakan regulasi wilayah yang Anda sampaikan.\\n\\nArsitek prinsipal kami akan segera menghubungi Anda kembali dalam kurun waktu < 24 jam untuk menjadwalkan sesi konsultasi perdana secara tatap muka maupun virtual.\\n\\nSalam hangat,\\nLayanan Kemitraan AETHER ARCHITECTURE\\nGrand Sudirman Tower Lt. 18, Jakarta`;\n    } else if (inq.status === \'reviewing\') {\n      content = `Yth. ${clientName},\\n\\nMenindaklanjuti pengajuan rencana proyek ${pType} (${ticketId}), kami ingin menginformasikan bahwa berkas permohonan Anda kini masuk dalam tahap:\\n*ANALISIS PARAMETER DAN TATA RUANG (IN-REVIEW)*.\\n\\nProyek Anda telah ditugaskan kepada Arsitek Utama kami, ${architect}, yang memiliki spesialisasi tinggi di bidang tersebut. Saat ini kami sedang menyusun laporan awal terkait:\\n1. Koefisien Dasar Bangunan (KDB) & Koefisien Lantai Bangunan (KLB) zonasi tapak.\\n2. Analisis awal respon mikroklimat lingkungan tapak.\\n\\nKami akan mengirimkan undangan diskusi teknis via Zoom dalam 1-2 hari kerja.\\n\\nHormat kami,\\n${architect}\\nLead Architect - AETHER Studio`;\n    } else if (inq.status === \'approved\') {\n      content = `Yth. ${clientName},\\n\\nKabar baik. Berdasarkan hasil pengkajian awal kelayakan teknis dan visi spasial yang Anda ajukan, AETHER ARCHITECTURE dengan bangga menyatakan bahwa proyek Anda:\\n*DISETUJUI UNTUK MASUK TAHAP PRA-RANCANGAN KONSEPTUAL*.\\n\\nDetail Rekomendasi Awal:\\n- Lead Architect: ${architect}\\n- Estimasi Siklus Desain: ${timeline}\\n- Skala Alokasi Anggaran: ${inq.budget}\\n- Catatan PM: ${inq.adminNotes || \'Sesuai dengan kriteria desain ekologis studio.\'}\\n\\nLangkah selanjutnya adalah penandatanganan Dokumen Kontrak Perencanaan Sipil serta pengukuran kontur tanah fisik oleh surveyor lapangan. Kami mengundang Anda menghadiri Kick-off Meeting di studio kami pada waktu yang disepakati.\\n\\nHormat kami,\\nManajemen Operasional Proyek\\nAETHER ARCHITECTURE`;\n    } else if (inq.status === \'declined\') {\n      content = `Yth. ${clientName},\\n\\nTerima kasih atas kepercayaan yang Anda berikan kepada AETHER ARCHITECTURE dengan mengajukan rencana proyek ${pType} (${ticketId}).\\n\\nSetelah dilakukan peninjauan mendalam oleh komite kurator studio kami, dengan sangat menyesal kami menginformasikan bahwa saat ini kami belum dapat memproses rencana kerja Anda lebih lanjut.\\n\\nAlasan Utama Penolakan:\\n${inq.adminNotes || \'Keterbatasan kapasitas jadwal produksi studio atau ketidaksesuaian parameter tapak dengan regulasi zonasi setempat.\'}\\n\\nKami sangat mengapresiasi visi desain Anda dan berharap dapat berkolaborasi di kesempatan proyek lain di masa mendatang.\\n\\nHormat kami,\\nKomite Kurasi Proyek\\nAETHER ARCHITECTURE`;\n    }\n\n    return content;\n  };\n\n  const handleCopyDraft = (text: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedDraft(true);\n    setTimeout(() => setCopiedDraft(false), 3000);\n  };\n\n  // Onboarding Workflow Step check (Simulated interactive progress)\n  const steps = [\n    { label: \'Analisis Regulasi (KDB/KLB)\', desc: \'Pemeriksaan peraturan daerah dan batas tapak\' },\n    { label: \'Kunjungan Tapak\', desc: \'Pengukuran kontur fisik tanah & orientasi matahari\' },\n    { label: \'Penyusunan Program Ruang\', desc: \'Menetapkan daftar fungsi ruang detail\' },\n    { label: \'Pra-Rancangan (3D Sketsa)\', desc: \'Visualisasi awal massa bangunan dan sirkulasi\' }\n  ];\n\n  return (\n    <div id=\"admin-panel-container\" className=\"mx-auto max-w-7xl px-6 py-8 sm:px-8\">\n      \n      {/* Title Header */}\n      <div className=\"flex flex-col md:flex-row md:items-center md:justify-between border-b pb-6 mb-8 border-border-light dark:border-border-dark\" id=\"admin-header-row\">\n        <div>\n          <span className=\"font-mono text-[10px] uppercase tracking-[0.25em] text-muted-light dark:text-muted-dark font-semibold\">\n            PORTAL INTERNAL PM\n          </span>\n          <h1 className=\"font-display text-2xl font-bold uppercase tracking-wide mt-1\">\n            Studio Workflow & Project Pipeline\n          </h1>\n        </div>\n        \n        {/* Actions bar */}\n        <div className=\"mt-4 md:mt-0 flex flex-wrap items-center gap-3\" id=\"admin-header-actions\">\n          <button\n            onClick={onResetInquiries}\n            className=\"flex items-center space-x-1.5 border px-4 py-2 text-xs font-mono uppercase tracking-widest text-muted-light border-border-light hover:border-red-500 hover:text-red-500 transition-colors duration-200 cursor-pointer\"\n            id=\"btn-reset-data\"\n            title=\"Reset ke data awal jika ingin melakukan testing dari awal\"\n          >\n            <RefreshCw size={12} />\n            <span>Reset Demo Data</span>\n          </button>\n          \n          <div className=\"flex bg-black/5 dark:bg-white/5 p-1 border border-border-light dark:border-border-dark\" id=\"tab-selectors\">\n            <button\n              onClick={() => setActiveTab(\'inbox\')}\n              className={`px-3 py-1.5 text-[10px] font-mono uppercase tracking-widest transition-colors cursor-pointer ${\n                activeTab === \'inbox\' \n                  ? \'bg-primary-light text-bg-light dark:bg-primary-dark dark:text-bg-dark font-semibold\' \n                  : \'text-muted-light dark:text-muted-dark hover:text-primary-light dark:hover:text-primary-dark\'\n              }`}\n            >\n              Inbox ({filteredInquiries.length})\n            </button>\n            <button\n              onClick={() => setActiveTab(\'kanban\')}\n              className={`px-3 py-1.5 text-[10px] font-mono uppercase tracking-widest transition-colors cursor-pointer ${\n                activeTab === \'kanban\' \n                  ? \'bg-primary-light text-bg-light dark:bg-primary-dark dark:text-bg-dark font-semibold\' \n                  : \'text-muted-light dark:text-muted-dark hover:text-primary-light dark:hover:text-primary-dark\'\n              }`}\n            >\n              Board Kanban\n            </button>\n            <button\n              onClick={() => setActiveTab(\'analytics\')}\n              className={`px-3 py-1.5 text-[10px] font-mono uppercase tracking-widest transition-colors cursor-pointer ${\n                activeTab === \'analytics\' \n                  ? \'bg-primary-light text-bg-light dark:bg-primary-dark dark:text-bg-dark font-semibold\' \n                  : \'text-muted-light dark:text-muted-dark hover:text-primary-light dark:hover:text-primary-dark\'\n              }`}\n            >\n              Analisis\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Metric summary banner */}\n      <div className=\"grid grid-cols-2 gap-4 md:grid-cols-5 mb-8\" id=\"admin-metrics-grid\">\n        \n        <div className=\"border p-4 bg-black/[0.02] dark:bg-white/[0.02] border-border-light dark:border-border-dark flex flex-col justify-between h-24\">\n          <span className=\"font-mono text-[9px] text-muted-light dark:text-muted-dark uppercase tracking-wider block\">Total Pipeline</span>\n          <span className=\"font-display text-lg font-bold text-primary-light dark:text-primary-dark\">{formatIDR(totalPipeline)}</span>\n          <span className=\"font-mono text-[8px] text-green-600 dark:text-green-400 uppercase tracking-widest flex items-center gap-1\">\n            <TrendingUp size={10} /> Aktif & Prospek\n          </span>\n        </div>\n\n        <div className=\"border p-4 bg-black/[0.02] dark:bg-white/[0.02] border-border-light dark:border-border-dark flex flex-col justify-between h-24\">\n          <span className=\"font-mono text-[9px] text-muted-light dark:text-muted-dark uppercase tracking-wider block\">Antrean Baru</span>\n          <span className=\"font-display text-lg font-bold text-amber-600 dark:text-amber-400\">{pendingCount}</span>\n          <span className=\"font-mono text-[8px] text-muted-light dark:text-muted-dark uppercase tracking-widest\">\n            Perlu Tinjauan Awal\n          </span>\n        </div>\n\n        <div className=\"border p-4 bg-black/[0.02] dark:bg-white/[0.02] border-border-light dark:border-border-dark flex flex-col justify-between h-24\">\n          <span className=\"font-mono text-[9px] text-muted-light dark:text-muted-dark uppercase tracking-wider block\">Sedang Ditinjau</span>\n          <span className=\"font-display text-lg font-bold text-blue-600 dark:text-blue-400\">{reviewingCount}</span>\n          <span className=\"font-mono text-[8px] text-muted-light dark:text-muted-dark uppercase tracking-widest\">\n            Zonasi & Regulasi\n          </span>\n        </div>\n\n        <div className=\"border p-4 bg-black/[0.02] dark:bg-white/[0.02] border-border-light dark:border-border-dark flex flex-col justify-between h-24\">\n          <span className=\"font-mono text-[9px] text-muted-light dark:text-muted-dark uppercase tracking-wider block\">Disetujui</span>\n          <span className=\"font-display text-lg font-bold text-green-600 dark:text-green-400\">{approvedCount}</span>\n          <span className=\"font-mono text-[8px] text-muted-light dark:text-muted-dark uppercase tracking-widest\">\n            Kontrak Desain\n          </span>\n        </div>\n\n        <div className=\"border p-4 bg-black/[0.02] dark:bg-white/[0.02] border-border-light dark:border-border-dark flex flex-col justify-between h-24 col-span-2 md:col-span-1\">\n          <span className=\"font-mono text-[9px] text-muted-light dark:text-muted-dark uppercase tracking-wider block\">Ditolak</span>\n          <span className=\"font-display text-lg font-bold text-red-600 dark:text-red-400\">{declinedCount}</span>\n          <span className=\"font-mono text-[8px] text-muted-light dark:text-muted-dark uppercase tracking-widest\">\n            Diarsipkan\n          </span>\n        </div>\n\n      </div>\n\n      {/* Main views layout container */}\n      <div id=\"admin-main-views-stage\">\n        \n        {/* Tab 1: Inbox Split View */}\n        {activeTab === \'inbox\' && (\n          <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\" id=\"inbox-split-layout\">\n            \n            {/* Left Column: Filter and List (5 Cols) */}\n            <div className=\"lg:col-span-5 flex flex-col space-y-4\" id=\"inbox-list-pane\">\n              \n              {/* Search & Simple filter header */}\n              <div className=\"border p-4 bg-black/[0.01] dark:bg-white/[0.01] border-border-light dark:border-border-dark space-y-3\" id=\"filters-header\">\n                \n                {/* Search Bar */}\n                <div className=\"relative\">\n                  <Search size={14} className=\"absolute left-3 top-1/2 -translate-y-1/2 text-muted-light dark:text-muted-dark\" />\n                  <input\n                    type=\"text\"\n                    placeholder=\"Cari nama, tiket, atau tantangan...\"\n                    value={searchTerm}\n                    onChange={(e) => setSearchTerm(e.target.value)}\n                    className=\"w-full border py-2 pl-9 pr-4 text-xs bg-transparent focus:outline-none focus:border-primary-light dark:focus:border-primary-dark border-border-light dark:border-border-dark\"\n                  />\n                </div>\n\n                {/* Dropdowns */}\n                <div className=\"grid grid-cols-2 gap-2\">\n                  <div className=\"flex flex-col space-y-1\">\n                    <label className=\"font-mono text-[8px] uppercase tracking-wider text-muted-light dark:text-muted-dark font-semibold\">Status</label>\n                    <select\n                      value={statusFilter}\n                      onChange={(e) => setStatusFilter(e.target.value)}\n                      className=\"border p-1.5 text-[10px] bg-transparent focus:outline-none focus:border-primary-light dark:focus:border-primary-dark border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark\"\n                    >\n                      <option value=\"all\" className=\"bg-bg-light dark:bg-bg-dark text-primary-light dark:text-primary-dark\">Semua Status</option>\n                      <option value=\"pending\" className=\"bg-bg-light dark:bg-bg-dark text-primary-light dark:text-primary-dark\">Baru (Pending)</option>\n                      <option value=\"reviewing\" className=\"bg-bg-light dark:bg-bg-dark text-primary-light dark:text-primary-dark\">Ditinjau (Review)</option>\n                      <option value=\"approved\" className=\"bg-bg-light dark:bg-bg-dark text-primary-light dark:text-primary-dark\">Disetujui (Approved)</option>\n                      <option value=\"declined\" className=\"bg-bg-light dark:bg-bg-dark text-primary-light dark:text-primary-dark\">Ditolak (Declined)</option>\n                    </select>\n                  </div>\n\n                  <div className=\"flex flex-col space-y-1\">\n                    <label className=\"font-mono text-[8px] uppercase tracking-wider text-muted-light dark:text-muted-dark font-semibold\">Klasifikasi</label>\n                    <select\n                      value={typeFilter}\n                      onChange={(e) => setTypeFilter(e.target.value)}\n                      className=\"border p-1.5 text-[10px] bg-transparent focus:outline-none focus:border-primary-light dark:focus:border-primary-dark border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark\"\n                    >\n                      <option value=\"all\" className=\"bg-bg-light dark:bg-bg-dark\">Semua Kategori</option>\n                      <option value=\"Komersial\" className=\"bg-bg-light dark:bg-bg-dark\">Komersial</option>\n                      <option value=\"Residensial\" className=\"bg-bg-light dark:bg-bg-dark\">Residensial</option>\n                      <option value=\"Urban\" className=\"bg-bg-light dark:bg-bg-dark\">Urban</option>\n                      <option value=\"Lainnya\" className=\"bg-bg-light dark:bg-bg-dark\">Lainnya</option>\n                    </select>\n                  </div>\n                </div>\n\n              </div>\n\n              {/* Inquiry List cards */}\n              <div className=\"space-y-3 overflow-y-auto max-h-[600px] pr-1\" id=\"inquiry-list-scroll\">\n                {filteredInquiries.length === 0 ? (\n                  <div className=\"border p-8 text-center text-xs text-muted-light dark:text-muted-dark border-dashed border-border-light dark:border-border-dark\">\n                    Tidak ada pengajuan proyek yang cocok dengan filter pencarian.\n                  </div>\n                ) : (\n                  filteredInquiries.map((inq) => {\n                    const isSelected = inq.id === selectedInquiryId;\n                    const isNew = !inq.status || inq.status === \'pending\';\n                    \n                    let statusLabel = \'Baru\';\n                    let statusColor = \'bg-amber-100 text-amber-800 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900\';\n                    \n                    if (inq.status === \'reviewing\') {\n                      statusLabel = \'Ditinjau\';\n                      statusColor = \'bg-blue-100 text-blue-800 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-900\';\n                    } else if (inq.status === \'approved\') {\n                      statusLabel = \'Disetujui\';\n                      statusColor = \'bg-green-100 text-green-800 border-green-200 dark:bg-green-950/40 dark:text-green-300 dark:border-green-900\';\n                    } else if (inq.status === \'declined\') {\n                      statusLabel = \'Ditolak\';\n                      statusColor = \'bg-red-100 text-red-800 border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-900\';\n                    }\n\n                    return (\n                      <div\n                        key={inq.id}\n                        onClick={() => setSelectedInquiryId(inq.id)}\n                        id={`inquiry-card-${inq.id}`}\n                        className={`border p-4 transition-all duration-200 cursor-pointer relative ${\n                          isSelected \n                            ? \'border-primary-light bg-black/[0.04] dark:border-primary-dark dark:bg-white/[0.04] shadow-md\' \n                            : \'border-border-light hover:border-muted-light dark:border-border-dark dark:hover:border-muted-dark bg-transparent\'\n                        }`}\n                      >\n                        {isNew && (\n                          <span className=\"absolute top-0 right-0 h-2 w-2 bg-amber-500 rounded-full mt-2 mr-2 animate-pulse\" />\n                        )}\n\n                        <div className=\"flex items-center justify-between mb-2\">\n                          <span className=\"font-mono text-[9px] font-bold tracking-wider uppercase text-muted-light dark:text-muted-dark\">\n                            {inq.id}\n                          </span>\n                          <span className={`text-[8px] font-mono font-semibold uppercase px-2 py-0.5 border ${statusColor}`}>\n                            {statusLabel}\n                          </span>\n                        </div>\n\n                        <h4 className=\"font-display text-xs font-bold text-primary-light dark:text-primary-dark line-clamp-1\">\n                          {inq.name}\n                        </h4>\n\n                        <p className=\"text-[11px] text-muted-light dark:text-muted-dark line-clamp-2 mt-1 leading-relaxed\">\n                          {inq.details}\n                        </p>\n\n                        <div className=\"flex items-center justify-between mt-3 pt-2.5 border-t border-border-light/40 dark:border-border-dark/40 font-mono text-[9px] text-muted-light dark:text-muted-dark\">\n                          <span className=\"font-semibold uppercase text-primary-light dark:text-primary-dark\">\n                            {inq.projectType}\n                          </span>\n                          <span>{inq.date}</span>\n                        </div>\n                      </div>\n                    );\n                  })\n                )}\n              </div>\n\n            </div>\n\n            {/* Right Column: Inquiry Detailed Workflow & Actions (7 Cols) */}\n            <div className=\"lg:col-span-7\" id=\"inbox-detail-pane\">\n              {selectedInquiry ? (\n                <div className=\"border p-6 space-y-6 border-border-light dark:border-border-dark bg-black/[0.01] dark:bg-white/[0.01]\" id=\"detail-card-panel\">\n                  \n                  {/* Detailed Card Title */}\n                  <div className=\"flex flex-col sm:flex-row sm:items-start sm:justify-between border-b pb-4 border-border-light dark:border-border-dark\">\n                    <div>\n                      <div className=\"flex items-center space-x-2\">\n                        <span className=\"font-mono text-[10px] font-bold tracking-widest text-muted-light dark:text-muted-dark\">\n                          TIKET {selectedInquiry.id}\n                        </span>\n                        {selectedInquiry.priority && (\n                          <span className={`text-[8px] font-mono px-1.5 py-0.5 border uppercase font-semibold ${\n                            selectedInquiry.priority === \'high\' \n                              ? \'bg-red-50 text-red-700 border-red-100 dark:bg-red-950/20 dark:text-red-400 dark:border-red-900/40\' \n                              : selectedInquiry.priority === \'medium\'\n                              ? \'bg-blue-50 text-blue-700 border-blue-100 dark:bg-blue-950/20 dark:text-blue-400 dark:border-blue-900/40\'\n                              : \'bg-gray-50 text-gray-700 border-gray-100 dark:bg-gray-950/20 dark:text-gray-400 dark:border-gray-900/40\'\n                          }`}>\n                            Prio: {selectedInquiry.priority}\n                          </span>\n                        )}\n                      </div>\n                      <h3 className=\"font-display text-lg font-bold uppercase text-primary-light dark:text-primary-dark mt-1\">\n                        {selectedInquiry.name}\n                      </h3>\n                      <p className=\"text-xs text-muted-light dark:text-muted-dark mt-0.5\">\n                        Korespondensi: <span className=\"underline font-mono text-[11px]\">{selectedInquiry.email}</span>\n                      </p>\n                    </div>\n\n                    <div className=\"mt-3 sm:mt-0 flex flex-wrap gap-1\" id=\"fast-status-buttons\">\n                      <button\n                        onClick={() => handleStatusChange(\'reviewing\')}\n                        className={`px-3 py-1 text-[9px] font-mono uppercase tracking-wider border cursor-pointer ${\n                          selectedInquiry.status === \'reviewing\'\n                            ? \'bg-blue-600 text-white border-blue-600 dark:bg-blue-500 dark:border-blue-500\'\n                            : \'border-border-light dark:border-border-dark hover:border-blue-500 text-muted-light dark:text-muted-dark\'\n                        }`}\n                      >\n                        Tinjau\n                      </button>\n                      <button\n                        onClick={() => handleStatusChange(\'approved\')}\n                        className={`px-3 py-1 text-[9px] font-mono uppercase tracking-wider border cursor-pointer ${\n                          selectedInquiry.status === \'approved\'\n                            ? \'bg-green-600 text-white border-green-600 dark:bg-green-500 dark:border-green-500\'\n                            : \'border-border-light dark:border-border-dark hover:border-green-500 text-muted-light dark:text-muted-dark\'\n                        }`}\n                      >\n                        Setujui\n                      </button>\n                      <button\n                        onClick={() => handleStatusChange(\'declined\')}\n                        className={`px-3 py-1 text-[9px] font-mono uppercase tracking-wider border cursor-pointer ${\n                          selectedInquiry.status === \'declined\'\n                            ? \'bg-red-600 text-white border-red-600 dark:bg-red-500 dark:border-red-500\'\n                            : \'border-border-light dark:border-border-dark hover:border-red-500 text-muted-light dark:text-muted-dark\'\n                        }`}\n                      >\n                        Tolak\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* Parameter & Details submitted by client */}\n                  <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 border-b pb-6 border-border-light dark:border-border-dark\" id=\"client-specs-grid\">\n                    <div className=\"space-y-1\">\n                      <span className=\"font-mono text-[9px] uppercase tracking-wider text-muted-light dark:text-muted-dark block\">Kategori Proyek</span>\n                      <span className=\"text-xs font-semibold text-primary-light dark:text-primary-dark uppercase block\">\n                        {selectedInquiry.projectType}\n                      </span>\n                    </div>\n\n                    <div className=\"space-y-1\">\n                      <span className=\"font-mono text-[9px] uppercase tracking-wider text-muted-light dark:text-muted-dark block\">Alokasi Anggaran</span>\n                      <span className=\"text-xs font-semibold text-primary-light dark:text-primary-dark block\">\n                        {selectedInquiry.budget}\n                      </span>\n                    </div>\n\n                    <div className=\"col-span-2 space-y-1.5 pt-2\">\n                      <span className=\"font-mono text-[9px] uppercase tracking-wider text-muted-light dark:text-muted-dark block\">Kebutuhan Ruang & Parameter Tapak</span>\n                      <div className=\"border p-4 bg-black/[0.02] dark:bg-white/[0.02] border-border-light dark:border-border-dark rounded text-xs leading-relaxed text-primary-light dark:text-primary-dark font-light whitespace-pre-wrap\">\n                        {selectedInquiry.details}\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* PM Interactive Controls Flow */}\n                  <div className=\"space-y-5\" id=\"pm-controls-box\">\n                    <div className=\"flex items-center space-x-1\">\n                      <Clipboard size={14} className=\"text-primary-light dark:text-primary-dark\" />\n                      <h4 className=\"font-mono text-[10px] font-bold uppercase tracking-widest text-primary-light dark:text-primary-dark\">\n                        PENGELOLAAN ALUR KERJA PM\n                      </h4>\n                    </div>\n\n                    {/* Work Assignment & Parameters */}\n                    <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n                      \n                      {/* Select Architect */}\n                      <div className=\"flex flex-col space-y-1.5\">\n                        <label className=\"font-mono text-[9px] uppercase tracking-wider text-muted-light dark:text-muted-dark font-semibold\">Arsitek Utama (Lead)</label>\n                        <select\n                          value={selectedInquiry.assignedTo || \'\'}\n                          onChange={(e) => handleFieldChange(\'assignedTo\', e.target.value)}\n                          className=\"border p-2 text-xs bg-transparent text-primary-light dark:text-primary-dark border-border-light dark:border-border-dark focus:outline-none focus:border-primary-light dark:focus:border-primary-dark\"\n                        >\n                          <option value=\"\">-- Belum Ditugaskan --</option>\n                          {ARCHITECTS.map(arch => (\n                            <option key={arch.name} value={arch.name}>{arch.name}</option>\n                          ))}\n                        </select>\n                        {selectedInquiry.assignedTo && (\n                          <span className=\"font-mono text-[8px] text-muted-light dark:text-muted-dark block\">\n                            Spe: {ARCHITECTS.find(a => a.name === selectedInquiry.assignedTo)?.specialty}\n                          </span>\n                        )}\n                      </div>\n\n                      {/* Select Priority */}\n                      <div className=\"flex flex-col space-y-1.5\">\n                        <label className=\"font-mono text-[9px] uppercase tracking-wider text-muted-light dark:text-muted-dark font-semibold\">Prioritas Pengkajian</label>\n                        <select\n                          value={selectedInquiry.priority || \'medium\'}\n                          onChange={(e) => handleFieldChange(\'priority\', e.target.value)}\n                          className=\"border p-2 text-xs bg-transparent text-primary-light dark:text-primary-dark border-border-light dark:border-border-dark focus:outline-none focus:border-primary-light dark:focus:border-primary-dark\"\n                        >\n                          <option value=\"low\">Low (Santai)</option>\n                          <option value=\"medium\">Medium (Standar)</option>\n                          <option value=\"high\">High (Mendesak)</option>\n                        </select>\n                      </div>\n\n                      {/* Timeline Estimate */}\n                      <div className=\"flex flex-col space-y-1.5\">\n                        <label className=\"font-mono text-[9px] uppercase tracking-wider text-muted-light dark:text-muted-dark font-semibold\">Estimasi Masa Kerja</label>\n                        <select\n                          value={selectedInquiry.timelineEstimate || \'3 - 6 Bulan\'}\n                          onChange={(e) => handleFieldChange(\'timelineEstimate\', e.target.value)}\n                          className=\"border p-2 text-xs bg-transparent text-primary-light dark:text-primary-dark border-border-light dark:border-border-dark focus:outline-none focus:border-primary-light dark:focus:border-primary-dark\"\n                        >\n                          <option value=\"3 - 6 Bulan\">3 - 6 Bulan</option>\n                          <option value=\"6 - 12 Bulan\">6 - 12 Bulan</option>\n                          <option value=\"> 12 Bulan\">&gt; 12 Bulan</option>\n                        </select>\n                      </div>\n\n                    </div>\n\n                    {/* Internal Notes textarea */}\n                    <div className=\"flex flex-col space-y-1.5\">\n                      <label className=\"font-mono text-[9px] uppercase tracking-wider text-muted-light dark:text-muted-dark font-semibold\">\n                        Catatan Evaluasi Internal PM *\n                      </label>\n                      <textarea\n                        rows={3}\n                        value={selectedInquiry.adminNotes || \'\'}\n                        onChange={(e) => handleFieldChange(\'adminNotes\', e.target.value)}\n                        placeholder=\"Tulis analisis zonasi lahan, kelayakan struktur, catatan KDB/KLB, serta rencana survei tapak...\"\n                        className=\"w-full border px-4 py-3 text-xs bg-transparent text-primary-light dark:text-primary-dark border-border-light dark:border-border-dark focus:outline-none focus:border-primary-light dark:focus:border-primary-dark resize-none font-light\"\n                      />\n                    </div>\n\n                    {/* Interactive Process Flow checklist */}\n                    <div className=\"border p-4 bg-black/[0.01] dark:bg-white/[0.01] border-border-light dark:border-border-dark\">\n                      <span className=\"font-mono text-[8px] uppercase tracking-widest text-muted-light dark:text-muted-dark block mb-3 font-bold\">\n                        Daftar Pemeriksaan Pra-Sesi Konsultasi (Simulasi Operasional)\n                      </span>\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\" id=\"checklist-grid\">\n                        {steps.map((st, idx) => {\n                          const key = `step_checked_${idx}`;\n                          // Storing checks on local state simulation is optional, let\'s just make them interactive via checklist clicks\n                          return (\n                            <label \n                              key={idx}\n                              className=\"flex items-start space-x-3 text-xs p-2.5 rounded hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer border border-transparent hover:border-border-light dark:hover:border-border-dark transition-all\"\n                            >\n                              <input \n                                type=\"checkbox\" \n                                defaultChecked={idx <= (selectedInquiry.status === \'approved\' ? 3 : selectedInquiry.status === \'reviewing\' ? 1 : 0)}\n                                className=\"mt-0.5 rounded border-border-light dark:border-border-dark text-primary-light dark:text-primary-dark focus:ring-transparent h-3.5 w-3.5\"\n                              />\n                              <div>\n                                <p className=\"font-semibold text-[11px] leading-tight text-primary-light dark:text-primary-dark\">{st.label}</p>\n                                <p className=\"text-[9px] text-muted-light dark:text-muted-dark mt-0.5 leading-tight\">{st.desc}</p>\n                              </div>\n                            </label>\n                          );\n                        })}\n                      </div>\n                    </div>\n\n                    {/* Generated Client Notification Draft Panel */}\n                    <div className=\"border p-4 bg-black/5 dark:bg-white/5 border-border-light dark:border-border-dark rounded\" id=\"client-notification-box\">\n                      <div className=\"flex items-center justify-between border-b pb-2 mb-3 border-border-light dark:border-border-dark\">\n                        <span className=\"font-mono text-[9px] uppercase tracking-widest text-primary-light dark:text-primary-dark flex items-center gap-1.5 font-bold\">\n                          <Mail size={12} /> Draf Surat Respons Korespondensi Client\n                        </span>\n                        <button\n                          onClick={() => handleCopyDraft(generateClientLetter(selectedInquiry))}\n                          className=\"flex items-center space-x-1 border px-2.5 py-1 text-[9px] font-mono uppercase tracking-widest text-muted-light border-border-light hover:border-primary-light hover:text-primary-light dark:border-border-dark dark:hover:border-primary-dark dark:text-muted-dark dark:hover:text-primary-dark transition-colors cursor-pointer\"\n                        >\n                          <Copy size={10} />\n                          <span>{copiedDraft ? \'Copied \342\234\223\' : \'Salin Draf\'}</span>\n                        </button>\n                      </div>\n\n                      <pre className=\"text-[10px] font-mono leading-relaxed whitespace-pre-wrap text-muted-light dark:text-muted-dark max-h-[180px] overflow-y-auto bg-black/5 p-3 border border-border-light/40 dark:border-border-dark/40 rounded\">\n                        {generateClientLetter(selectedInquiry)}\n                      </pre>\n                    </div>\n\n                  </div>\n\n                </div>\n              ) : (\n                <div className=\"border p-12 text-center text-xs text-muted-light dark:text-muted-dark border-dashed border-border-light dark:border-border-dark h-[500px] flex flex-col justify-center\">\n                  <Inbox size={48} className=\"mx-auto mb-4 text-muted-light/40\" />\n                  Pilih salah satu tiket pengajuan di sebelah kiri untuk meninjau detail dan mengelola alur kerjanya.\n                </div>\n              )}\n            </div>\n\n          </div>\n        )}\n\n        {/* Tab 2: Kanban Pipeline Board */}\n        {activeTab === \'kanban\' && (\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-6\" id=\"kanban-grid-layout\">\n            \n            {/* Statuses definitions */}\n            {([\'pending\', \'reviewing\', \'approved\', \'declined\'] as const).map(status => {\n              const items = inquiries.filter(i => (!i.status && status === \'pending\') || i.status === status);\n              \n              let headerTitle = \'Baru (Pending)\';\n              let headerColor = \'border-amber-400 text-amber-600 dark:text-amber-400\';\n              let indicatorBg = \'bg-amber-400\';\n\n              if (status === \'reviewing\') {\n                headerTitle = \'Dalam Peninjauan\';\n                headerColor = \'border-blue-400 text-blue-600 dark:text-blue-400\';\n                indicatorBg = \'bg-blue-400\';\n              } else if (status === \'approved\') {\n                headerTitle = \'Disetujui (Approved)\';\n                headerColor = \'border-green-400 text-green-600 dark:text-green-400\';\n                indicatorBg = \'bg-green-400\';\n              } else if (status === \'declined\') {\n                headerTitle = \'Arsip (Ditolak)\';\n                headerColor = \'border-red-400 text-red-600 dark:text-red-400\';\n                indicatorBg = \'bg-red-400\';\n              }\n\n              return (\n                <div key={status} className=\"flex flex-col space-y-4\" id={`kanban-col-${status}`}>\n                  \n                  {/* Column Header */}\n                  <div className={`border-b-2 pb-2 flex items-center justify-between ${headerColor}`}>\n                    <span className=\"font-mono text-xs font-bold uppercase tracking-wider\">\n                      {headerTitle}\n                    </span>\n                    <span className={`text-[10px] font-mono px-2 py-0.5 rounded-full text-bg-light dark:text-bg-dark ${indicatorBg} font-bold`}>\n                      {items.length}\n                    </span>\n                  </div>\n\n                  {/* Kanban Cards */}\n                  <div className=\"space-y-3 min-h-[500px] bg-black/[0.01] dark:bg-white/[0.01] p-2 border border-border-light/40 dark:border-border-dark/40 overflow-y-auto max-h-[550px]\" id={`kanban-cards-container-${status}`}>\n                    {items.length === 0 ? (\n                      <div className=\"text-center py-12 text-[10px] text-muted-light dark:text-muted-dark border border-dashed border-border-light/40 dark:border-border-dark/40 rounded\">\n                        Kosong\n                      </div>\n                    ) : (\n                      items.map(inq => (\n                        <div\n                          key={inq.id}\n                          onClick={() => {\n                            setSelectedInquiryId(inq.id);\n                            setActiveTab(\'inbox\');\n                          }}\n                          className=\"border p-3.5 bg-bg-light hover:border-primary-light transition-all duration-200 cursor-pointer shadow-sm dark:bg-bg-dark border-border-light dark:border-border-dark hover:shadow-md relative group\"\n                        >\n                          <div className=\"flex items-center justify-between mb-2\">\n                            <span className=\"font-mono text-[8px] tracking-wider text-muted-light dark:text-muted-dark group-hover:text-primary-light dark:group-hover:text-primary-dark transition-colors\">\n                              {inq.id}\n                            </span>\n                            <span className=\"text-[8px] font-mono bg-black/5 dark:bg-white/5 px-1.5 py-0.5\">\n                              {inq.projectType}\n                            </span>\n                          </div>\n\n                          <h5 className=\"font-display text-xs font-bold text-primary-light dark:text-primary-dark leading-snug line-clamp-1\">\n                            {inq.name}\n                          </h5>\n\n                          <p className=\"text-[10px] text-muted-light dark:text-muted-dark line-clamp-2 mt-1 leading-relaxed\">\n                            {inq.details}\n                          </p>\n\n                          <div className=\"border-t border-border-light/40 dark:border-border-dark/40 mt-3 pt-2 flex items-center justify-between text-[9px] text-muted-light dark:text-muted-dark font-mono\">\n                            <span className=\"font-semibold text-[10px] text-primary-light dark:text-primary-dark\">\n                              {inq.budget}\n                            </span>\n                            <span>{inq.date.split(\' \')[0]}</span>\n                          </div>\n                        </div>\n                      ))\n                    )}\n                  </div>\n\n                </div>\n              );\n            })}\n\n          </div>\n        )}\n\n        {/* Tab 3: Analytics Panel */}\n        {activeTab === \'analytics\' && (\n          <div className=\"space-y-8\" id=\"analytics-tab-panel\">\n            \n            {/* Charts Row */}\n            <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8\" id=\"analytics-grid\">\n              \n              {/* Load Capacity Chart (7 Cols) */}\n              <div className=\"border p-6 border-border-light dark:border-border-dark bg-black/[0.01] dark:bg-white/[0.01] lg:col-span-7 space-y-6\" id=\"architect-workload-chart\">\n                <div>\n                  <h4 className=\"font-display text-sm font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark\">\n                    Beban Kerja & Penugasan Arsitek Utama\n                  </h4>\n                  <p className=\"text-xs text-muted-light dark:text-muted-dark mt-1\">\n                    Visualisasi pembagian tugas untuk proyek aktif yang disetujui atau sedang ditinjau.\n                  </p>\n                </div>\n\n                <div className=\"space-y-4 pt-2\">\n                  {ARCHITECTS.map(arch => {\n                    const assignedItems = inquiries.filter(\n                      i => i.assignedTo === arch.name && i.status !== \'declined\'\n                    );\n                    const approvedCount = assignedItems.filter(i => i.status === \'approved\').length;\n                    const reviewingCount = assignedItems.filter(i => i.status === \'reviewing\').length;\n                    const totalLead = assignedItems.length;\n\n                    // Compute a percentage bar based on total load (max capacity is e.g. 5 projects)\n                    const percent = Math.min((totalLead / 5) * 100, 100);\n\n                    return (\n                      <div key={arch.name} className=\"space-y-1.5\" id={`workload-row-${arch.name.replace(/\\s+/g, \'-\').toLowerCase()}`}>\n                        <div className=\"flex justify-between items-end\">\n                          <div>\n                            <span className=\"text-xs font-bold text-primary-light dark:text-primary-dark\">{arch.name}</span>\n                            <span className=\"text-[10px] text-muted-light dark:text-muted-dark block font-mono\">{arch.specialty}</span>\n                          </div>\n                          <div className=\"font-mono text-[10px] text-right\">\n                            <span className=\"font-semibold text-primary-light dark:text-primary-dark\">{totalLead} Proyek Aktif</span>\n                            <span className=\"text-muted-light dark:text-muted-dark block text-[9px]\">\n                              ({approvedCount} Disetujui, {reviewingCount} Ditinjau)\n                            </span>\n                          </div>\n                        </div>\n\n                        {/* Custom Progress bar */}\n                        <div className=\"h-2 w-full bg-black/5 dark:bg-white/5 border border-border-light dark:border-border-dark rounded-sm overflow-hidden flex\">\n                          <div \n                            style={{ width: `${percent}%` }}\n                            className={`h-full transition-all duration-500 ${\n                              totalLead >= 4 \n                                ? \'bg-red-500\' \n                                : totalLead >= 2 \n                                ? \'bg-primary-light dark:bg-primary-dark\' \n                                : \'bg-blue-400\'\n                            }`}\n                          />\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                <div className=\"border p-4 bg-black/[0.02] dark:bg-white/[0.02] border-border-light dark:border-border-dark text-[11px] text-muted-light dark:text-muted-dark leading-relaxed font-mono\">\n                  \360\237\222\241 <span className=\"font-bold text-primary-light dark:text-primary-dark uppercase text-[10px]\">Panduan Kapasitas PM:</span> Maksimum kapasitas beban ideal per arsitek prinsipal adalah 3 proyek aktif secara simultan demi menjaga kualitas rancangan presisi tinggi khas studio Aether.\n                </div>\n              </div>\n\n              {/* Category Share & Key metrics (5 Cols) */}\n              <div className=\"border p-6 border-border-light dark:border-border-dark bg-black/[0.01] dark:bg-white/[0.01] lg:col-span-5 space-y-6\" id=\"category-share-analytics\">\n                <div>\n                  <h4 className=\"font-display text-sm font-bold uppercase tracking-wider text-primary-light dark:text-primary-dark\">\n                    Klasifikasi Portfolio Masuk\n                  </h4>\n                  <p className=\"text-xs text-muted-light dark:text-muted-dark mt-1\">\n                    Komposisi minat pasar berdasarkan klasifikasi kategori permohonan proyek.\n                  </p>\n                </div>\n\n                <div className=\"space-y-4 pt-2\">\n                  {[\'Komersial\', \'Residensial\', \'Urban\', \'Lainnya\'].map(cat => {\n                    const count = inquiries.filter(i => i.projectType === cat).length;\n                    const pct = totalCount > 0 ? (count / totalCount) * 100 : 0;\n\n                    return (\n                      <div key={cat} className=\"space-y-1\">\n                        <div className=\"flex justify-between text-xs font-mono\">\n                          <span className=\"uppercase text-muted-light dark:text-muted-dark\">{cat}</span>\n                          <span className=\"font-semibold text-primary-light dark:text-primary-dark\">\n                            {count} Proyek ({pct.toFixed(0)}%)\n                          </span>\n                        </div>\n\n                        <div className=\"h-1.5 w-full bg-black/5 dark:bg-white/5 overflow-hidden flex rounded-sm\">\n                          <div \n                            style={{ width: `${pct}%` }}\n                            className=\"h-full bg-primary-light dark:bg-primary-dark transition-all duration-500\"\n                          />\n                        </div>\n                      </div>\n                    );\n                  })}\n                </div>\n\n                {/* Additional KPI cards */}\n                <div className=\"grid grid-cols-2 gap-4 border-t pt-6 border-border-light/40 dark:border-border-dark/40\" id=\"analytics-kpis\">\n                  <div className=\"space-y-1\">\n                    <span className=\"font-mono text-[8px] uppercase tracking-wider text-muted-light dark:text-muted-dark block\">Rasio Persetujuan</span>\n                    <span className=\"text-lg font-display font-bold text-green-600 dark:text-green-400\">\n                      {totalCount > 0 ? ((approvedCount / totalCount) * 100).toFixed(0) : 0}%\n                    </span>\n                  </div>\n\n                  <div className=\"space-y-1\">\n                    <span className=\"font-mono text-[8px] uppercase tracking-wider text-muted-light dark:text-muted-dark block\">Kecepatan Respons</span>\n                    <span className=\"text-lg font-display font-bold text-blue-600 dark:text-blue-400\">\n                      &lt; 24 Jam\n                    </span>\n                  </div>\n                </div>\n\n              </div>\n\n            </div>\n\n          </div>\n        )}\n\n      </div>\n\n    </div>\n  );\n}\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import React, { useState, useEffect } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Inbox, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Layers, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  BarChart3, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
